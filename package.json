{
  "name": "nf-calendar",
  "version": "1.0.1",
  "description": "Calendar + daily/weekly/monthly notes with weekday and rule-based templates, important days and statistics (fork of liamcain/obsidian-calendar-plugin)",
  "author": "Nomber (fork of Calendar by Liam Cain)",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "lint": "svelte-check && eslint .",
    "build": "npm run lint && rollup -c",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "dist": "npm run build && npm test && bash scripts/dist.sh"
  },
  "dependencies": {
    "obsidian": "1.8.7",
    "obsidian-calendar-ui": "0.3.12",
    "svelte": "3.59.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "18.0.0",
    "@rollup/plugin-node-resolve": "11.2.1",
    "@rollup/plugin-typescript": "11.1.6",
    "@tsconfig/svelte": "1.0.10",
    "@types/jest": "29.5.14",
    "@types/moment": "2.13.0",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.5.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "moment": "2.31.0",
    "rollup": "^2.80.0",
    "rollup-plugin-svelte": "7.1.0",
    "svelte-check": "1.3.0",
    "svelte-jester": "1.3.2",
    "svelte-preprocess": "5.1.4",
    "ts-jest": "29.2.5",
    "tslib": "2.6.3",
    "typescript": "5.4.5",
    "typescript-eslint": "8.72.2"
  },
  "jest": {
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "testEnvironment": "node"
  },
  "overrides": {
    "obsidian": "1.8.7",
    "moment": "2.31.0",
    "tslib": "2.6.3",
    "svelte": "3.59.2"
  },
  "homepage": "https://github.com/NOMBER/NF-Calendar",
  "repository": {
    "type": "git",
    "url": "https://github.com/NOMBER/NF-Calendar.git"
  },
  "bugs": "https://github.com/NOMBER/NF-Calendar/issues"
}
